{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Phase0DenyDeleteExceptRoot",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteObject*"
      ],
      "Resource": [
        "arn:aws:s3:::lottery-partitioned-storage-prod",
        "arn:aws:s3:::lottery-partitioned-storage-prod/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::913524903233:root"
        }
      }
    }
  ]
}
